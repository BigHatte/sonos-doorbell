# Vorlage für die Umgebungsvariablen des Stacks.
# Portainer: Werte unter "Environment variables" eintragen (oder diese Datei
# mit "Load variables from .env file" laden).
# Lokal: als .env neben docker-compose.yml speichern.

# Pflicht: LAN-IP des Docker-Hosts. Die Sonos-Boxen laden darüber den Gong.
ADVERTISE_HOST=<ip-des-docker-hosts>

# Räume ohne zones-Parameter, kommagetrennt, oder "all".
DEFAULT_ZONES=Wohnzimmer,Küche

# Gong-Datei ohne Endung aus sounds/ und Lautstärke (0-100).
DEFAULT_SOUND=gong
DEFAULT_VOLUME=30
# Abweichende Lautstärke pro Raum.
ZONE_VOLUMES=Küche=40,Bad=20

# Empfohlen: feste IPs der Boxen (schneller, keine Suche nötig).
PLAYERS=Wohnzimmer=<ip-wohnzimmer>,Küche=<ip-küche>,Bad=<ip-bad>

COOLDOWN_S=3
PORT=5005
LOG_LEVEL=INFO
TZ=Europe/Berlin
