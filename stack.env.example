# Vorlage für die Umgebungsvariablen des Stacks.
# Portainer: Werte unter "Environment variables" eintragen (oder diese Datei
# mit "Load variables from .env file" laden).
# Lokal: als .env neben docker-compose.yml speichern.
#
# Alles Folgende ist optional. Boxen, Profile, Gongs und die Adresse des
# Docker-Hosts werden in der Weboberfläche (http://<nas-ip>:5005) verwaltet.
# Die Werte unter "Startwerte" werden nur beim allerersten Start gelesen,
# solange es noch keine Konfiguration im Volume gibt. Danach zählt allein die
# Weboberfläche; spätere Änderungen hier haben keine Wirkung.

# --- Prozess-Einstellungen (wirken bei jedem Start) ---
PORT=5005
LOG_LEVEL=INFO
TZ=Europe/Berlin

# --- Startwerte (nur beim ersten Start) ---
# LAN-IP des Docker-Hosts; leer = automatisch erkennen.
ADVERTISE_HOST=
# Boxen mit festen IPs: Name=IP, kommagetrennt.
PLAYERS=Wohnzimmer=<ip-wohnzimmer>,Küche=<ip-küche>
# Räume des angelegten Profils "Standard", kommagetrennt, oder "all".
DEFAULT_ZONES=all
# Gong: ding-dong, dreiklang, einzelton oder westminster.
DEFAULT_SOUND=ding-dong
# Lautstärke (0-100), optional abweichend pro Raum.
DEFAULT_VOLUME=30
ZONE_VOLUMES=Küche=40
# Sperrzeit des Profils in Sekunden.
COOLDOWN_S=3
